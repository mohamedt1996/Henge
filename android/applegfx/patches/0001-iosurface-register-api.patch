diff --git a/src/protocol/iosurface_api.c b/src/protocol/iosurface_api.c
new file mode 100644
index 0000000..bdd1782
--- /dev/null
+++ b/src/protocol/iosurface_api.c
@@ -0,0 +1,268 @@
+/* src/protocol/iosurface_api.c — public host-mapped IOSurface registration
+ *
+ * Copyright © 2026 Matthew Jackson
+ * SPDX-License-Identifier: MIT
+ *
+ * Implements lagfx_iosurface_register / lagfx_iosurface_refresh /
+ * lagfx_iosurface_unregister (declared in include/libapplegfx-vulkan.h).
+ *
+ * Motivation: the in-band IOSFC command ring (handlers/iosurface/) learns
+ * about IOSurfaces from guest CmdCreateIOSurfaceBacking2 traffic over the
+ * apple-gfx PCI transport. An embedder driving the MMIO transport variant
+ * (Henge's android/applegfx bridge) resolves a surface's backing pages
+ * out-of-band and needs a direct, transport-agnostic way to hand those
+ * host-mapped pages to the renderer. These functions are that path.
+ *
+ * The implementation reuses the library's own IOSurface machinery
+ * (lagfx_vk_iosurface_create + _upload_pixels + the resource registry keyed by
+ * surface id as TEXTURE), so a surface registered here is indistinguishable,
+ * downstream, from one created by the guest ring.
+ *
+ * register vs. refresh: register (re)creates the VkImage backing; refresh
+ * re-uploads current guest-page contents into the *existing* backing without
+ * recreating it, for a surface the guest keeps redrawing. An embedder calls
+ * refresh per vblank; two optimizations keep that cheap:
+ *   - contiguous fast path: when a surface's mapped pages are contiguous in
+ *     host memory (the common case for a single mmap-backed guest RAM), the
+ *     page contents are read in place — no intermediate gather copy.
+ *   - dirty detection: refresh hashes the current page contents and skips the
+ *     GPU re-upload when the hash matches the last upload (the MMIO transport
+ *     has no 0x3b BackingUpdate signal, so content hashing stands in for it). */
+
+#include "libapplegfx-vulkan.h"
+#include "state.h"
+#include "../device.h"
+#include "resource_registry.h"
+#include "../common/log.h"
+
+#ifdef LAGFX_HAVE_VULKAN
+#include "../vulkan/iosurface.h"
+#endif
+
+#include <stdlib.h>
+#include <string.h>
+
+/* Resolve device -> protocol state -> resource registry. Returns NULL and
+ * logs if the device isn't valid or the protocol state isn't attached yet. */
+static lagfx_resource_registry_t *registry_of(lagfx_device_t *device) {
+    if (!lagfx_device_is_valid(device)) return NULL;
+    lagfx_protocol_t *p = (lagfx_protocol_t *)device->protocol_state;
+    if (!p) {
+        LAGFX_WARN("iosurface_api: device has no protocol state");
+        return NULL;
+    }
+    return &p->resources;
+}
+
+#ifdef LAGFX_HAVE_VULKAN
+/* Result of resolving a mapping's pages to a readable linear byte span. */
+typedef struct {
+    const uint8_t *data;  /* NULL if nothing to read */
+    size_t         len;
+    int            owned; /* 1 => data is malloc'd and must be freed */
+} lagfx_gather_t;
+
+/* Resolve the mapping's host-mapped pages to a contiguous readable byte span,
+ * in guest-physical order (the surface's linear pixel storage). When the pages
+ * are already contiguous in host memory the span points straight at them
+ * (owned=0, no copy — the "external-memory-ish" fast path for the staging
+ * upload). Otherwise the scattered pages are gathered into one malloc'd buffer
+ * (owned=1). We cover at most alloc_size bytes (or page_count*page_size,
+ * whichever is smaller); upload_pixels zero-pads short / truncates long. */
+static lagfx_gather_t gather_pages(const lagfx_iosurface_mapping_t *m) {
+    lagfx_gather_t g = {NULL, 0u, 0};
+    if (!m->page_host_addrs || !m->page_count || !m->page_size) return g;
+    size_t span = (size_t)m->page_count * (size_t)m->page_size;
+    size_t want = (m->alloc_size && (size_t)m->alloc_size < span)
+                      ? (size_t)m->alloc_size : span;
+    if (!want) return g;
+
+    /* Contiguous? page_host_addrs[i] == base + i*page_size for every page. */
+    int contiguous = (m->page_host_addrs[0] != NULL);
+    for (uint32_t i = 1; contiguous && i < m->page_count; i++) {
+        const uint8_t *expect = (const uint8_t *)m->page_host_addrs[0]
+                                + (size_t)i * m->page_size;
+        if (m->page_host_addrs[i] != (const void *)expect) contiguous = 0;
+    }
+    if (contiguous) {
+        g.data = (const uint8_t *)m->page_host_addrs[0];
+        g.len = want;
+        g.owned = 0;
+        return g;
+    }
+
+    uint8_t *buf = (uint8_t *)malloc(want);
+    if (!buf) return g;
+    size_t got = 0u;
+    for (uint32_t i = 0; i < m->page_count && got < want; i++) {
+        const void *src = m->page_host_addrs[i];
+        size_t chunk = m->page_size;
+        if (got + chunk > want) chunk = want - got;
+        if (src) memcpy(buf + got, src, chunk);
+        else     memset(buf + got, 0, chunk); /* unmapped hole */
+        got += chunk;
+    }
+    g.data = buf; g.len = got; g.owned = 1;
+    return g;
+}
+
+static void gather_free(lagfx_gather_t *g) {
+    if (g->owned && g->data) free((void *)g->data);
+    g->data = NULL; g->len = 0; g->owned = 0;
+}
+
+/* Fast 64-bit content hash (FNV-1a over 8-byte words, byte tail). Used only to
+ * decide whether the content changed since the last upload; not cryptographic. */
+static uint64_t content_hash(const uint8_t *p, size_t n) {
+    uint64_t h = 1469598103934665603ull;
+    size_t i = 0;
+    for (; i + 8 <= n; i += 8) {
+        uint64_t w;
+        memcpy(&w, p + i, 8);
+        h = (h ^ w) * 1099511628211ull;
+    }
+    for (; i < n; i++)
+        h = (h ^ (uint64_t)p[i]) * 1099511628211ull;
+    return h ^ (uint64_t)n;
+}
+#endif /* LAGFX_HAVE_VULKAN */
+
+lagfx_status_t lagfx_iosurface_register(lagfx_device_t *device,
+                                        const lagfx_iosurface_mapping_t *m) {
+    if (!lagfx_device_is_valid(device) || !m) return LAGFX_ERR_INVALID_ARG;
+    if (m->width == 0u || m->height == 0u) {
+        LAGFX_WARN("iosurface_register: id=0x%x degenerate %ux%u — rejected",
+                   m->mapping_id, m->width, m->height);
+        return LAGFX_ERR_INVALID_ARG;
+    }
+
+    lagfx_resource_registry_t *reg = registry_of(device);
+    if (!reg) return LAGFX_ERR_INVALID_ARG;
+
+    const uint32_t task_id = 0u;
+    lagfx_resource_register(reg, m->mapping_id, LAGFX_RESOURCE_TYPE_TEXTURE,
+                            task_id, 0u, m->alloc_size);
+
+#ifndef LAGFX_HAVE_VULKAN
+    LAGFX_LOG("iosurface_register: id=0x%x %ux%u recorded (no Vulkan backend)",
+              m->mapping_id, m->width, m->height);
+    return LAGFX_OK;
+#else
+    if (!device->vk) {
+        LAGFX_WARN("iosurface_register: id=0x%x recorded, vk not ready — "
+                   "no backing yet", m->mapping_id);
+        return LAGFX_OK;
+    }
+
+    lagfx_gather_t g = gather_pages(m);
+
+    lagfx_vk_iosurface_t *ios = NULL;
+    lagfx_status_t st = lagfx_vk_iosurface_create(device->vk, m->width,
+                                                  m->height, m->pixel_format,
+                                                  &ios);
+    if (st != LAGFX_OK || !ios) {
+        gather_free(&g);
+        LAGFX_ERR("iosurface_register: id=0x%x VkImage create failed (%d)",
+                  m->mapping_id, (int)st);
+        return LAGFX_ERR_BACKEND;
+    }
+
+    uint64_t hash = 0u;
+    if (g.data && g.len) {
+        hash = content_hash(g.data, g.len);
+        st = lagfx_vk_iosurface_upload_pixels(device->vk, ios, g.data, g.len);
+        if (st != LAGFX_OK)
+            LAGFX_WARN("iosurface_register: id=0x%x upload failed (%d) — "
+                       "backing bound empty", m->mapping_id, (int)st);
+    }
+    gather_free(&g);
+
+    lagfx_resource_entry_t *e = lagfx_resource_lookup(reg, m->mapping_id,
+                                                      task_id);
+    if (e) {
+        if (e->host_handle)
+            lagfx_vk_iosurface_release(device->vk,
+                                       (lagfx_vk_iosurface_t *)e->host_handle);
+        e->host_handle = ios;
+        e->refresh_hash = hash;
+    } else {
+        lagfx_vk_iosurface_release(device->vk, ios);
+        LAGFX_ERR("iosurface_register: id=0x%x registry entry vanished",
+                  m->mapping_id);
+        return LAGFX_ERR_INTERNAL;
+    }
+
+    LAGFX_LOG("iosurface_register: id=0x%x %ux%u fmt=0x%x bound (%zu bytes%s)",
+              m->mapping_id, m->width, m->height, m->pixel_format, g.len,
+              g.owned ? "" : ", contiguous");
+    return LAGFX_OK;
+#endif /* LAGFX_HAVE_VULKAN */
+}
+
+lagfx_status_t lagfx_iosurface_refresh(lagfx_device_t *device,
+                                       const lagfx_iosurface_mapping_t *m) {
+    if (!lagfx_device_is_valid(device) || !m) return LAGFX_ERR_INVALID_ARG;
+    lagfx_resource_registry_t *reg = registry_of(device);
+    if (!reg) return LAGFX_ERR_INVALID_ARG;
+
+    const uint32_t task_id = 0u;
+    lagfx_resource_entry_t *e = lagfx_resource_lookup(reg, m->mapping_id,
+                                                      task_id);
+    if (!e
+#ifdef LAGFX_HAVE_VULKAN
+        || !e->host_handle
+#endif
+       )
+        return lagfx_iosurface_register(device, m);
+
+#ifndef LAGFX_HAVE_VULKAN
+    (void)e;
+    return LAGFX_OK;
+#else
+    if (!device->vk) return LAGFX_OK;
+
+    lagfx_gather_t g = gather_pages(m);
+    if (!g.data || !g.len) { gather_free(&g); return LAGFX_OK; }
+
+    /* Dirty detection: skip the GPU re-upload when the content is unchanged. */
+    uint64_t hash = content_hash(g.data, g.len);
+    if (hash == e->refresh_hash) { gather_free(&g); return LAGFX_OK; }
+
+    /* NB: upload_pixels transitions the image and copies via a staging buffer;
+     * if a frame is concurrently sampling this surface the embedder orders
+     * refresh against submission (the bridge does it from its vblank pump). */
+    lagfx_status_t st = lagfx_vk_iosurface_upload_pixels(
+        device->vk, (lagfx_vk_iosurface_t *)e->host_handle, g.data, g.len);
+    gather_free(&g);
+    if (st != LAGFX_OK) {
+        LAGFX_WARN("iosurface_refresh: id=0x%x re-upload failed (%d)",
+                   m->mapping_id, (int)st);
+        return st;
+    }
+    e->refresh_hash = hash;
+    return LAGFX_OK;
+#endif /* LAGFX_HAVE_VULKAN */
+}
+
+lagfx_status_t lagfx_iosurface_unregister(lagfx_device_t *device,
+                                          uint32_t mapping_id) {
+    if (!lagfx_device_is_valid(device)) return LAGFX_ERR_INVALID_ARG;
+    lagfx_resource_registry_t *reg = registry_of(device);
+    if (!reg) return LAGFX_ERR_INVALID_ARG;
+
+    const uint32_t task_id = 0u;
+    lagfx_resource_entry_t *e = lagfx_resource_lookup(reg, mapping_id, task_id);
+    if (!e) return LAGFX_ERR_NOT_FOUND;
+
+#ifdef LAGFX_HAVE_VULKAN
+    if (e->host_handle && device->vk) {
+        lagfx_vk_iosurface_release(device->vk,
+                                   (lagfx_vk_iosurface_t *)e->host_handle);
+        e->host_handle = NULL;
+    }
+#endif
+    e->refresh_hash = 0u;
+    lagfx_resource_unregister(reg, mapping_id, task_id);
+    LAGFX_LOG("iosurface_unregister: id=0x%x released", mapping_id);
+    return LAGFX_OK;
+}
