  * lifecycle. */
 LAGFX_EXPORT lagfx_status_t lagfx_device_register_shader_catalog(lagfx_device_t *device);
 
+/* === IOSurface host-mapping registration ====================== */
+
+/* Describes a guest IOSurface whose backing pages the embedder (e.g.
+ * a vmapple/apple-gfx MMIO transport bridge) has already mapped into
+ * host memory. The pages are the surface's linear pixel storage in
+ * guest-physical order; page_host_addrs[i] is the host virtual address
+ * of the i-th page. The library gathers them into a contiguous upload
+ * and binds a sampleable VkImage keyed on mapping_id.
+ *
+ * This is the entry point referenced in Henge's android/applegfx
+ * bridge: the apple-gfx PCI transport registers IOSurfaces through the
+ * in-band IOSFC command ring, but an MMIO transport that has resolved
+ * the surface's host pages out-of-band needs a direct way to hand them
+ * to the renderer. lagfx_iosurface_register is that way. */
+typedef struct {
+    uint32_t          mapping_id;      /* surface_id / registry key      */
+    uint32_t          pixel_format;    /* Metal MTLPixelFormat code      */
+    uint32_t          width;           /* pixels                         */
+    uint32_t          height;          /* pixels                         */
+    uint32_t          bytes_per_row;   /* guest stride (0 => width*4)    */
+    uint64_t          alloc_size;      /* total backing bytes            */
+    const void *const *page_host_addrs;/* host VAs, page_count entries   */
+    uint32_t          page_count;      /* number of mapped pages         */
+    uint32_t          page_size;       /* bytes per page (e.g. 16384)    */
+} lagfx_iosurface_mapping_t;
+
+/* Register (or re-register) a host-mapped IOSurface. Gathers the mapped
+ * pages into a BGRA/RGBA upload, creates a sampleable VkImage, and binds
+ * it in the resource registry as a TEXTURE under mapping->mapping_id so
+ * the composite/blit paths resolve it by id. Re-registering an existing
+ * mapping_id releases the previous backing first (no leak, no double-free).
+ *
+ * Returns LAGFX_OK on success. Without Vulkan (LAGFX_HAVE_VULKAN off) the
+ * registry entry is still recorded and LAGFX_OK returned, so bookkeeping
+ * and unregister stay symmetric; no image is created. LAGFX_ERR_INVALID_ARG
+ * on a NULL/!valid device or malformed mapping; LAGFX_ERR_OUT_OF_MEMORY if
+ * the gather buffer can't be allocated; LAGFX_ERR_BACKEND if image
+ * creation fails. */
+LAGFX_EXPORT lagfx_status_t lagfx_iosurface_register(
+    lagfx_device_t *device, const lagfx_iosurface_mapping_t *mapping);
+
+/* Release the backing registered for mapping_id and drop its registry
+ * entry. Safe to call for an unknown id (returns LAGFX_ERR_NOT_FOUND).
+ * Safe on a NULL/!valid device (returns LAGFX_ERR_INVALID_ARG). */
+LAGFX_EXPORT lagfx_status_t lagfx_iosurface_unregister(
+    lagfx_device_t *device, uint32_t mapping_id);
+
 /* === Capability / introspection =============================== */
 
 LAGFX_EXPORT int lagfx_version_major(void);
